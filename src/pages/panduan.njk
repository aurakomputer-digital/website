<!-- SCRIPTS -->
<script>
  // ============================================
  // SEARCH & FILTER FUNCTIONALITY
  // ============================================
  const searchInput = document.getElementById("searchInput");
  const filterPills = document.querySelectorAll(".filter-pill");
  const appCards = document.querySelectorAll(".app-card");
  const appCountEl = document.getElementById("appCount");
  const emptyStateEl = document.getElementById("emptyState");
  const appsGrid = document.getElementById("appsGrid");

  let currentFilter = "all";
  let currentSearch = "";

  function updateApps() {
    let visibleCount = 0;

    appCards.forEach((card, index) => {
      const category = card.dataset.category;
      const name = card.dataset.title;
      const description = card.dataset.description;

      const matchFilter = currentFilter === "all" || category === currentFilter;
      const matchSearch =
        currentSearch === "" ||
        name.includes(currentSearch) ||
        description.includes(currentSearch);

      if (matchFilter && matchSearch) {
        card.style.display = "";
        card.style.animation = `fadeUp 0.5s ease-out ${index * 0.03}s both`;
        visibleCount++;
      } else {
        card.style.display = "none";
      }
    });

    appCountEl.textContent = visibleCount;

    if (visibleCount === 0) {
      emptyStateEl.classList.remove("hidden");
      appsGrid.classList.add("hidden");
    } else {
      emptyStateEl.classList.add("hidden");
      appsGrid.classList.remove("hidden");
    }
  }

  // Search functionality
  searchInput.addEventListener("input", function (e) {
    currentSearch = e.target.value.toLowerCase().trim();
    updateApps();
  });

  // Filter functionality
  filterPills.forEach((pill) => {
    pill.addEventListener("click", function () {
      currentFilter = this.dataset.filter;

      filterPills.forEach((p) => {
        p.classList.remove("active", "bg-brand-600", "text-white");
        p.classList.add("bg-slate-100", "text-slate-700");
      });
      this.classList.add("active", "bg-brand-600", "text-white");
      this.classList.remove("bg-slate-100", "text-slate-700");

      updateApps();
    });
  });

  // Reset search
  function resetSearch() {
    searchInput.value = "";
    currentSearch = "";
    currentFilter = "all";

    filterPills.forEach((p) => {
      p.classList.remove("active", "bg-brand-600", "text-white");
      p.classList.add("bg-slate-100", "text-slate-700");
    });
    filterPills[0].classList.add("active", "bg-brand-600", "text-white");
    filterPills[0].classList.remove("bg-slate-100", "text-slate-700");

    updateApps();
    searchInput.focus();
  }

  // Keyboard shortcut: Ctrl+K to focus search
  document.addEventListener("keydown", function (e) {
    if ((e.ctrlKey || e.metaKey) && e.key === "k") {
      e.preventDefault();
      searchInput.focus();
      searchInput.select();
    }
    if (e.key === "Escape" && document.activeElement === searchInput) {
      searchInput.blur();
    }
  });
</script>

<style>
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
