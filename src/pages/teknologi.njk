<!-- FILTER SCRIPT -->
<script>
  const filterPills = document.querySelectorAll(".filter-pill");
  const techCards = document.querySelectorAll(".tech-card");
  const techCountEl = document.getElementById("techCount");
  const emptyStateEl = document.getElementById("emptyState");
  const techGrid = document.getElementById("techGrid");

  function updateCount(visibleCount) {
    techCountEl.textContent = visibleCount;
    if (visibleCount === 0) {
      emptyStateEl.classList.remove("hidden");
      techGrid.classList.add("hidden");
    } else {
      emptyStateEl.classList.add("hidden");
      techGrid.classList.remove("hidden");
    }
  }

  filterPills.forEach((pill) => {
    pill.addEventListener("click", function () {
      const filter = this.dataset.filter;

      filterPills.forEach((p) => {
        p.classList.remove("active", "bg-brand-600", "text-white");
        p.classList.add("bg-slate-100", "text-slate-700");
      });
      this.classList.add("active", "bg-brand-600", "text-white");
      this.classList.remove("bg-slate-100", "text-slate-700");

      let visibleCount = 0;
      techCards.forEach((card, index) => {
        const category = card.dataset.category;
        const shouldShow = filter === "all" || category === filter;

        if (shouldShow) {
          card.style.display = "";
          card.style.animation = `fadeUp 0.5s ease-out ${index * 0.03}s both`;
          visibleCount++;
        } else {
          card.style.display = "none";
        }
      });

      updateCount(visibleCount);
    });
  });
</script>

<style>
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
