{# ============================================ #} {# META TAGS DASAR #} {#
============================================ #}
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta http-equiv="X-UA-Compatible" content="IE=edge" />

{# ============================================ #} {# PRIMARY META TAGS #} {#
============================================ #} {% set pageTitle = title or
seo.siteName %} {% set pageDesc = description or seo.description %} {% set
pageImage = image or seo.defaultImage %} {% set pageUrl = seo.url + page.url %}
{% set pageType = schemaType or "website" %}

<title>
  {{ pageTitle }}{% if title and title != seo.siteName %} | {{ seo.siteName }}{%
  endif %}
</title>
<meta name="title" content="{{ pageTitle }}" />
<meta name="description" content="{{ pageDesc }}" />
<meta name="author" content="{{ seo.author }}" />
<meta
  name="keywords"
  content="{% if keywords %}{{ keywords | join(', ') }}{% else %} jasa pembuatan aplikasi, software house banyumas, pembuatan website, aplikasi mobile, aplikasi desktop, digitalisasi sekolah, umkm digital{% endif %}"
/>
<meta
  name="robots"
  content="{% if noindex %}noindex, nofollow{% else %}index, follow{% endif %}"
/>
<meta name="googlebot" content="index, follow" />

{# Canonical URL #}
<link rel="canonical" href="{{ pageUrl }}" />

{# ============================================ #} {# OPEN GRAPH / FACEBOOK #}
{# ============================================ #}
<meta property="og:type" content="{{ pageType }}" />
<meta property="og:url" content="{{ pageUrl }}" />
<meta property="og:title" content="{{ pageTitle }}" />
<meta property="og:description" content="{{ pageDesc }}" />
<meta property="og:image" content="{{ pageImage }}" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="{{ pageTitle }}" />
<meta property="og:locale" content="{{ seo.locale }}" />
<meta property="og:site_name" content="{{ seo.siteName }}" />

{# ============================================ #} {# TWITTER CARD #} {#
============================================ #}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="{{ seo.social.twitter }}" />
<meta name="twitter:creator" content="{{ seo.social.twitter }}" />
<meta name="twitter:url" content="{{ pageUrl }}" />
<meta name="twitter:title" content="{{ pageTitle }}" />
<meta name="twitter:description" content="{{ pageDesc }}" />
<meta name="twitter:image" content="{{ pageImage }}" />
<meta name="twitter:image:alt" content="{{ pageTitle }}" />

{# ============================================ #} {# FAVICON & APP ICONS #} {#
============================================ #}
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/manifest.json" />
<meta name="theme-color" content="#4a62f5" />
<meta name="msapplication-TileColor" content="#4a62f5" />

{# ============================================ #} {# PRECONNECT & DNS PREFETCH
(PERFORMANCE) #} {# ============================================ #}
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
<link rel="preconnect" href="https://raw.githubusercontent.com" crossorigin />
<link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
<link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />
<link rel="dns-prefetch" href="https://raw.githubusercontent.com" />

{# ============================================ #} {# HREFLANG (jika
multi-bahasa) #} {# ============================================ #}
<link rel="alternate" hreflang="{{ seo.language }}" href="{{ pageUrl }}" />
<link rel="alternate" hreflang="x-default" href="{{ pageUrl }}" />

{# ============================================ #} {# VERIFICATION TAGS #} {#
============================================ #} {% if seo.googleSearchConsole %}
<meta name="google-site-verification" content="{{ seo.googleSearchConsole }}" />
{% endif %} {% if seo.bingWebmaster %}
<meta name="msvalidate.01" content="{{ seo.bingWebmaster }}" />
{% endif %}
