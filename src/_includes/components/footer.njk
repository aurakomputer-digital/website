<!-- FOOTER -->
<footer class="bg-ink text-slate-300">
  <div class="max-w-7xl mx-auto px-5 sm:px-8 py-14 grid md:grid-cols-4 gap-10">
    <div class="md:col-span-2">
      <div class="flex items-center gap-2">
        <img src="/assets/img/logo-alt.webp" alt="logo" class="h-20" />
      </div>
      <p class="mt-4 text-sm text-slate-400 max-w-md leading-relaxed">
        Software house lokal dari Banyumas yang siap mendigitalisasi sekolah,
        UMKM, dan instansi Anda dengan teknologi mutakhir yang handal dan mudah
        digunakan.
      </p>
      <div class="mt-6 flex gap-3">
        {% for contact in contact.items %}
        <a
          href="{{ contact.link }}"
          target="_blank"
          aria-label="{{ contact.name }}"
          class="w-9 h-9 rounded-full bg-white/10 hover:bg-brand-500 flex items-center justify-center transition"
        >
          <i class="{{ contact.icon }} text-white w-5"></i>
        </a>
        {% endfor %}
      </div>
    </div>

    <div>
      <h5 class="text-white font-bold mb-4">Layanan</h5>
      <ul class="space-y-2 text-sm">
        {% for entry in navigations.footer %}
        <li>
          <a href="{{ entry.url }}" class="hover:text-white transition"
            >{{ entry.title }}</a
          >
        </li>
        {% endfor %}
      </ul>
    </div>

    <div>
      <h5 class="text-white font-bold mb-4">Kontak</h5>
      <ul class="space-y-3 text-sm">
        <li class="flex items-start gap-2">
          <div>
            <i class="mt-1 fas fa-map-marker-alt text-white h-5 w-5"></i>
          </div>

          <span>{{ contact.address }}</span>
        </li>
        <li class="flex items-center gap-2">
          <div>
            <i class="mt-1 fas fa-phone-alt text-white h-4 w-4"></i>
          </div>

          <span>{{ contact.phone_number }}</span>
        </li>
        <li class="flex items-center gap-2">
          <div>
            <i class="mt-1 fas fa-envelope text-white h-4 w-4"></i>
          </div>
          <span>{{ contact.email }}</span>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div
      class="max-w-7xl mx-auto px-5 sm:px-8 py-6 flex flex-col sm:flex-row justify-between items-center gap-3 text-sm text-slate-400"
    >
      <div>
        &copy; {{ general.currentYear }} {{ site.title }}. Semua hak dilindungi.
      </div>
    </div>
  </div>
</footer>
