<!-- CTA -->
<section id="kontak" class="py-20 sm:py-28">
  <div class="max-w-6xl mx-auto px-5 sm:px-8">
    <div
      class="relative rounded-[2rem] overflow-hidden bg-gradient-to-br from-brand-700 via-brand-600 to-cyan-600 p-10 sm:p-16 text-white shadow-2xl shadow-brand-900/30"
    >
      <div
        class="absolute inset-0 opacity-20"
        style="
          background-image:
            radial-gradient(circle at 20% 20%, white 1px, transparent 1px),
            radial-gradient(circle at 80% 60%, white 1px, transparent 1px);
          background-size: 40px 40px;
        "
      ></div>
      <div class="relative grid lg:grid-cols-2 gap-10 items-center">
        <div>
          <h2
            class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight leading-tight"
          >
            Siap Mendigitalisasi Bisnis Anda?
          </h2>
          <p class="mt-4 text-white/85 text-lg">
            Konsultasikan ide Anda sekarang - <span class="font-bold text-xl">GRATIS</span>, tanpa komitmen. Tim kami
            siap membantu dari Banyumas ke seluruh Indonesia.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href="{{ contact.whatsapp.link }}"
              target="_blank"
              class="bg-white text-brand-700 font-bold px-6 py-3 rounded-full inline-flex items-center gap-2 hover:bg-slate-100 transition"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  d="M20.52 3.48A11.93 11.93 0 0 0 12.06 0C5.5 0 .17 5.33.17 11.89c0 2.09.55 4.13 1.6 5.94L0 24l6.33-1.66a11.88 11.88 0 0 0 5.73 1.46h.01c6.56 0 11.89-5.33 11.89-11.89 0-3.17-1.23-6.15-3.44-8.43zM12.07 21.8h-.01a9.9 9.9 0 0 1-5.04-1.38l-.36-.21-3.75.98 1-3.66-.24-.37a9.86 9.86 0 0 1-1.51-5.27c0-5.45 4.44-9.88 9.9-9.88 2.64 0 5.12 1.03 6.99 2.9a9.83 9.83 0 0 1 2.9 6.99c0 5.45-4.44 9.9-9.88 9.9zm5.43-7.41c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15s-.77.97-.94 1.17c-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.64-2.05-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51l-.57-.01c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.11 3.22 5.11 4.52.71.31 1.27.49 1.7.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2-1.41.25-.69.25-1.29.17-1.41-.07-.12-.27-.2-.57-.35z"
                />
              </svg>
              Chat WhatsApp
            </a>
            <a
              href="mailto:{{ contact.email }}"
              class="border border-white/40 hover:bg-white/10 font-semibold px-6 py-3 rounded-full inline-flex items-center gap-2 transition"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path
                  d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                />
                <polyline points="22,6 12,13 2,6" />
              </svg>
              {{ contact.email }}
            </a>
          </div>
        </div>
        <form
          id="contactForm"
          class="bg-white/10 backdrop-blur-md rounded-2xl p-6 border border-white/20 space-y-4"
        >
          <div>
            <label class="text-sm text-white/80">Nama Lengkap</label>
            <input
              required
              type="text"
              name="nama"
              id="input-nama"
              class="mt-1 w-full rounded-xl bg-white/90 text-ink px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-white"
              placeholder="John Doe"
            />
          </div>
          <div>
            <label class="text-sm text-white/80">Email / No. WA</label>
            <input
              required
              type="text"
              name="kontak"
              id="input-kontak"
              class="mt-1 w-full rounded-xl bg-white/90 text-ink px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-white"
              placeholder="email@domain.com atau 081234567890"
            />
          </div>
          <div>
            <label class="text-sm text-white/80">Jenis Layanan</label>
            <select
              name="layanan"
              id="input-layanan"
              class="mt-1 w-full rounded-xl bg-white/90 text-ink px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-white"
            >
              <option value="">-- Pilih Layanan --</option>
              <option value="Aplikasi Web">Aplikasi Web</option>
              <option value="Aplikasi Desktop">Aplikasi Desktop</option>
              <option value="Aplikasi Mobile">Aplikasi Mobile</option>
              <option value="Konsultasi Umum">Konsultasi Umum</option>
            </select>
          </div>
          <div>
            <label class="text-sm text-white/80"
              >Ceritakan Kebutuhan Anda</label
            >
            <textarea
              name="kebutuhan"
              id="input-kebutuhan"
              rows="3"
              class="mt-1 w-full rounded-xl bg-white/90 text-ink px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-white"
              placeholder="Saya butuh aplikasi untuk..."
            ></textarea>
          </div>
          <button
            type="submit"
            class="w-full bg-white text-brand-700 font-bold py-3 rounded-xl hover:bg-slate-100 transition flex items-center justify-center gap-2"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="currentColor"
            >
              <path
                d="M20.52 3.48A11.93 11.93 0 0 0 12.06 0C5.5 0 .17 5.33.17 11.89c0 2.09.55 4.13 1.6 5.94L0 24l6.33-1.66a11.88 11.88 0 0 0 5.73 1.46h.01c6.56 0 11.89-5.33 11.89-11.89 0-3.17-1.23-6.15-3.44-8.43z"
              />
            </svg>
            Kirim via WhatsApp
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  // Konfigurasi Nomor WhatsApp (ganti dengan nomor Anda)
  const WA_NUMBER = "6281234567890"; // Format: kode negara + nomor tanpa + atau 0 di depan

  // Event Listener untuk Form Submit
  document
    .getElementById("contactForm")
    .addEventListener("submit", function (e) {
      e.preventDefault(); // Mencegah form submit default

      // Ambil nilai dari form
      const nama = document.getElementById("input-nama").value.trim();
      const kontak = document.getElementById("input-kontak").value.trim();
      const layanan = document.getElementById("input-layanan").value;
      const kebutuhan = document.getElementById("input-kebutuhan").value.trim();

      // Validasi sederhana
      if (!nama || !kontak || !layanan || !kebutuhan) {
        alert("Mohon lengkapi semua field terlebih dahulu!");
        return;
      }

      // Buat template pesan WhatsApp
      const pesan = `
🚀 *KONSULTASI PROYEK DIGITAL*
━━━━━━━━━━━━━━━━━━━━━

📋 *DATA KLIEN*
━━━━━━━━━━━━━━━━━━━━━
👤 *Nama:* ${nama}
📞 *Kontak:* ${kontak}

💼 *DETAIL PROYEK*
━━━━━━━━━━━━━━━━━━━━━
🎯 *Jenis Layanan:* ${layanan}

📝 *Kebutuhan Klien:*
${kebutuhan}

━━━━━━━━━━━━━━━━━━━━━
💡 _Pesan ini dikirim otomatis dari website Banyumas Digital_
🌐 www.banyumasdigital.id
    `.trim();

      // Encode pesan untuk URL WhatsApp
      const pesanEncoded = encodeURIComponent(pesan);

      // Buat URL WhatsApp
      const waURL = `https://wa.me/${WA_NUMBER}?text=${pesanEncoded}`;

      // Buka WhatsApp di tab baru
      window.open(waURL, "_blank");

      // Optional: Reset form setelah submit
      // this.reset();

      // Optional: Tampilkan notifikasi sukses
      // alert("Anda akan diarahkan ke WhatsApp untuk melanjutkan konsultasi.");
    });
</script>
