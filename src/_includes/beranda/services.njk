<!-- SERVICES -->
<section id="layanan" class="py-20 sm:py-28 bg-white">
  <div class="max-w-7xl mx-auto px-5 sm:px-8">
    <div class="text-center max-w-2xl mx-auto reveal">
      <span
        class="chip inline-block text-xs font-semibold px-3 py-1.5 rounded-full"
      >
        Layanan Kami
      </span>
      <h2
        class="mt-4 text-3xl sm:text-4xl lg:text-5xl font-extrabold text-ink tracking-tight"
      >
        Solusi Digital <span class="gradient-text">End-to-End</span>
      </h2>
      <p class="mt-4 text-slate-600">
        Kami merancang, membangun, dan memelihara aplikasi yang sesuai dengan
        kebutuhan spesifik organisasi Anda.
      </p>
    </div>

    <!-- Features Grid -->
    <div class="mt-14 grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      {% for feature in site.features %}
      <div
        class="card-hover reveal group relative bg-white rounded-3xl p-7 border border-slate-100 overflow-hidden"
      >
        <!-- Background Gradient on Hover -->
        <div
          class="absolute inset-0 bg-gradient-to-br {{ feature.color }} opacity-0 group-hover:opacity-5 transition-opacity duration-500"
        ></div>

        <!-- Icon -->
        <div
          class="relative w-14 h-14 rounded-2xl bg-gradient-to-br {{ feature.color }} text-white flex items-center justify-center shadow-lg {{ feature.shadow }} mb-5"
        >
          <i class="{{ feature.icon }} w-8 h-8"></i>
        </div>

        <!-- Title -->
        <h3 class="relative text-xl font-bold text-ink mb-2">
          {{ feature.title }}
        </h3>

        <!-- Short Description -->
        <p class="relative text-sm font-medium text-brand-600 mb-3">
          {{ feature.shortDesc }}
        </p>

        <!-- Content -->
        <p class="relative text-sm text-slate-600 leading-relaxed mb-5">
          {{ feature.content }}
        </p>

        <!-- Highlight Stat -->
        {% if feature.highlight %}
        <div
          class="relative flex items-baseline gap-2 mb-4 pb-4 border-b border-slate-100"
        >
          <span class="text-3xl font-extrabold text-ink"
            >{{ feature.highlight.number }}</span
          >
          <span class="text-xs text-slate-500 uppercase tracking-wide"
            >{{ feature.highlight.label }}</span
          >
        </div>
        {% endif %}

        <!-- Tags -->
        {% if feature.tags %}
        <div class="relative flex flex-wrap gap-2 mb-4">
          {% for tag in feature.tags %}
          <span
            class="text-xs px-2.5 py-1 rounded-full bg-slate-100 text-slate-600 font-medium"
          >
            {{ tag }}
          </span>
          {% endfor %}
        </div>
        {% endif %}

        <!-- CTA Link -->
        {% if feature.cta %}
        <a
          href="{{ feature.link }}"
          class="relative inline-flex items-center gap-2 text-sm font-semibold text-brand-600 hover:text-brand-700 group/link"
        >
          {{ feature.cta }}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="transition-transform group-hover/link:translate-x-1"
          >
            <line x1="5" y1="12" x2="19" y2="12" />
            <polyline points="12 5 19 12 12 19" />
          </svg>
        </a>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
</section>
