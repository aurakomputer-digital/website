<!-- HERO -->
<section
  id="beranda"
  class="relative pt-28 lg:pt-36 pb-20 hero-bg overflow-hidden"
>
  <div class="absolute inset-0 grid-bg opacity-60 pointer-events-none"></div>
  <div
    class="max-w-7xl mx-auto px-5 sm:px-8 grid lg:grid-cols-2 gap-12 items-center relative"
  >
    <div class="animate-fade-up">
      <span
        class="chip inline-flex items-center gap-2 text-xs font-semibold px-3 py-1.5 rounded-full"
      >
        <span
          class="w-1.5 h-1.5 rounded-full bg-brand-600 animate-pulse"
        ></span>
        {{ site.tagline }}
      </span>
      <h1
        class="mt-5 text-3xl sm:text-4xl lg:text-5xl font-extrabold text-ink leading-tight tracking-tight"
      >
        Bangun Aplikasi
        <span class="gradient-text">Web, Desktop & Mobile</span> secara Efisien
      </h1>
      <p class="mt-5 text-lg text-slate-600 max-w-xl leading-relaxed">
        Jasa pembuatan aplikasi profesional yang siap mendigitalisasi
        <b>Sekolah</b>, <b>UMKM</b>, hingga <b>instansi</b> Anda dengan
        teknologi mutakhir yang mudah digunakan.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="#kontak"
          class="btn-primary text-white font-semibold px-6 py-3 rounded-full inline-flex items-center gap-2"
        >
          <span>Mulai Proyek</span>
          <i class="fas fa-arrow-right w-4 h-4"></i>
        </a>
        <a
          href="#layanan"
          class="border border-slate-300 hover:border-brand-500 hover:text-brand-600 font-semibold px-6 py-3 rounded-full inline-flex items-center gap-2 transition"
        >
          Lihat Layanan
        </a>
      </div>
      <div
        class="mt-10 flex flex-wrap items-center gap-6 text-sm text-slate-600"
      >
        <div class="flex items-center gap-2">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="#10b981"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="20 6 9 17 4 12" />
          </svg>
          Garansi Maintenance
        </div>
        <div class="flex items-center gap-2">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="#10b981"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="20 6 9 17 4 12" />
          </svg>
          Tim Lokal Banyumas
        </div>
        <div class="flex items-center gap-2">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="#10b981"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="20 6 9 17 4 12" />
          </svg>
          Teknologi Terkini
        </div>
      </div>
    </div>
    <div class="relative animate-fade-in">
      <div
        class="absolute -inset-6 bg-gradient-to-br from-brand-500/20 to-cyan-400/20 rounded-[2.5rem] blur-2xl"
      ></div>
      <div
        class="relative rounded-3xl overflow-hidden shadow-2xl shadow-brand-900/20 border border-white/60 animate-float"
      >
        <img
          src="https://image.qwenlm.ai/public_source/238775bb-2d71-45b6-8c78-8c2e9583e59e/1f5640d8c-7557-930f-a0ad-cfb50a3223f5.png"
          alt="Tim Banyumas Digital"
          class="w-full h-auto object-cover"
        />
      </div>
      <!-- Floating card -->
      <div
        class="hidden sm:flex absolute -left-6 top-10 bg-white rounded-2xl shadow-xl p-4 items-center gap-3 border border-slate-100 animate-fade-up"
        style="animation-delay: 0.3s"
      >
        <div
          class="w-10 h-10 rounded-xl bg-emerald-100 flex items-center justify-center text-emerald-600"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="20 6 9 17 4 12" />
          </svg>
        </div>
        <div>
          <div class="text-xs text-slate-500">Proyek Selesai</div>
          <div class="font-bold text-ink">120+ Aplikasi</div>
        </div>
      </div>
      <div
        class="hidden sm:flex absolute -right-4 bottom-10 bg-white rounded-2xl shadow-xl p-4 items-center gap-3 border border-slate-100 animate-fade-up"
        style="animation-delay: 0.6s"
      >
        <div
          class="w-10 h-10 rounded-xl bg-brand-100 flex items-center justify-center text-brand-600"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path
              d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 16.8 5.8 21.3l2.4-7.4L2 9.4h7.6z"
            />
          </svg>
        </div>
        <div>
          <div class="text-xs text-slate-500">Rating Klien</div>
          <div class="font-bold text-ink">4.9 / 5.0 ★</div>
        </div>
      </div>
    </div>
  </div>
  <!-- Stats -->
  <div class="max-w-7xl mx-auto px-5 sm:px-8 mt-16">
    <div
      class="grid grid-cols-2 md:grid-cols-4 gap-6 bg-white/70 backdrop-blur rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-lg"
    >
      {% for state in site.states %}
      <div class="text-center">
        <div class="text-3xl sm:text-4xl font-extrabold text-ink">
          {{ state.value }}
        </div>
        <div class="text-sm text-slate-500 mt-1">{{ state.title }}</div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
