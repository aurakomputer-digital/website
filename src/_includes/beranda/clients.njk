<!-- CLIENTS WITH FILTER -->
<section id="klien" class="py-20 sm:py-28 bg-white relative overflow-hidden">
  <div class="absolute inset-0 grid-bg opacity-30 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-5 sm:px-8 relative">
    <!-- Header Section -->
    <div class="text-center max-w-3xl mx-auto reveal">
      <span
        class="chip inline-block text-xs font-semibold px-3 py-1.5 rounded-full"
      >
        Portfolio Klien
      </span>
      <h2
        class="mt-4 text-3xl sm:text-4xl lg:text-5xl font-extrabold text-ink tracking-tight"
      >
        Telah Dipercaya oleh <span class="gradient-text">Berbagai Sektor</span>
      </h2>
      <p class="mt-4 text-lg text-slate-600">
        Kami bangga telah menjadi mitra digital bagi sekolah, UMKM, instansi
        pemerintah, dan perusahaan di seluruh Indonesia.
      </p>
    </div>

    <!-- Filter Buttons -->
    <div class="mt-12 flex flex-wrap justify-center gap-3 reveal">
      <button
        onclick="filterClients('all')"
        class="filter-btn active px-5 py-2.5 rounded-full text-sm font-semibold border-2 border-brand-500 bg-brand-500 text-white transition-all"
      >
        Semua
      </button>
      <button
        onclick="filterClients('Pendidikan')"
        class="filter-btn px-5 py-2.5 rounded-full text-sm font-semibold border-2 border-slate-300 text-slate-700 hover:border-brand-500 hover:text-brand-600 transition-all"
      >
        Pendidikan
      </button>
      <button
        onclick="filterClients('UMKM')"
        class="filter-btn px-5 py-2.5 rounded-full text-sm font-semibold border-2 border-slate-300 text-slate-700 hover:border-brand-500 hover:text-brand-600 transition-all"
      >
        UMKM
      </button>
      <button
        onclick="filterClients('Instansi')"
        class="filter-btn px-5 py-2.5 rounded-full text-sm font-semibold border-2 border-slate-300 text-slate-700 hover:border-brand-500 hover:text-brand-600 transition-all"
      >
        Instansi
      </button>
      <button
        onclick="filterClients('Korporat')"
        class="filter-btn px-5 py-2.5 rounded-full text-sm font-semibold border-2 border-slate-300 text-slate-700 hover:border-brand-500 hover:text-brand-600 transition-all"
      >
        Korporat
      </button>
    </div>

    <!-- Clients Grid -->
    <div
      class="mt-12 grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6"
      id="clientsGrid"
    >
      {% for client in clients %}
      <a
        href="{{ client.website }}"
        target="_blank"
        rel="noopener noreferrer"
        data-category="{{ client.category }}"
        class="client-card card-hover reveal group relative bg-white rounded-2xl p-6 border border-slate-200 hover:border-brand-300 transition-all duration-300 overflow-hidden"
      >
        <div
          class="absolute inset-0 bg-gradient-to-br from-brand-50 to-cyan-50 opacity-0 group-hover:opacity-100 transition-opacity duration-300"
        ></div>

        <div class="relative flex items-center justify-center h-24 mb-4">
          <img
            src="{{ client.logo }}"
            alt="Logo {{ client.name }}"
            class="max-h-full max-w-full object-contain grayscale group-hover:grayscale-0 transition-all duration-300"
            onerror="
              this.onerror = null;
              this.src = '/img/clients/placeholder.png';
            "
          />
        </div>

        <h3
          class="relative text-center font-bold text-ink text-sm mb-2 line-clamp-1 group-hover:text-brand-700 transition-colors"
        >
          {{ client.name }}
        </h3>

        <div class="relative flex justify-center mb-3">
          <span
            class="text-xs px-2.5 py-1 rounded-full {% if client.category == 'Pendidikan' %}bg-amber-100 text-amber-700 {% elif client.category == 'UMKM' %}bg-emerald-100 text-emerald-700 {% elif client.category == 'Instansi' %}bg-brand-100 text-brand-700 {% elif client.category == 'Korporat' %}bg-fuchsia-100 text-fuchsia-700 {% else %}bg-slate-100 text-slate-700{% endif %}"
          >
            {{ client.category }}
          </span>
        </div>

        <p
          class="relative text-center text-xs text-slate-600 line-clamp-2 leading-relaxed"
        >
          {{ client.description }}
        </p>

        <div
          class="absolute top-4 right-4 opacity-0 group-hover:opacity-100 transition-opacity duration-300"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-brand-600"
          >
            <line x1="7" y1="17" x2="17" y2="7" />
            <polyline points="7 7 17 7 17 17" />
          </svg>
        </div>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

<script>
  function filterClients(category) {
    const cards = document.querySelectorAll(".client-card");
    const buttons = document.querySelectorAll(".filter-btn");

    // Update button styles
    buttons.forEach((btn) => {
      btn.classList.remove(
        "active",
        "bg-brand-500",
        "text-white",
        "border-brand-500",
      );
      btn.classList.add("border-slate-300", "text-slate-700");
    });

    event.target.classList.add(
      "active",
      "bg-brand-500",
      "text-white",
      "border-brand-500",
    );
    event.target.classList.remove("border-slate-300", "text-slate-700");

    // Filter cards
    cards.forEach((card) => {
      if (category === "all" || card.dataset.category === category) {
        card.style.display = "block";
        card.style.animation = "fadeIn 0.5s ease-out";
      } else {
        card.style.display = "none";
      }
    });
  }
</script>
