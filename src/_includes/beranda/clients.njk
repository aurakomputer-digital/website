<!-- CLIENTS CAROUSEL WITH FILTER -->
<section id="klien" class="py-20 sm:py-28 bg-white relative overflow-hidden">
  <div class="absolute inset-0 grid-bg opacity-30 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-5 sm:px-8 relative">
    <!-- Header Section -->
    <div class="text-center max-w-3xl mx-auto reveal">
      <span
        class="chip inline-block text-xs font-semibold px-3 py-1.5 rounded-full"
      >
        Portfolio Klien
      </span>
      <h2
        class="mt-4 text-3xl sm:text-4xl lg:text-5xl font-extrabold text-ink tracking-tight"
      >
        Telah Dipercaya oleh <span class="gradient-text">Berbagai Sektor</span>
      </h2>
      <p class="mt-4 text-lg text-slate-600">
        Kami bangga telah menjadi mitra digital bagi sekolah, UMKM di seluruh
        Indonesia.
      </p>
    </div>

    <!-- Filter Buttons -->
    <div class="mt-12 flex flex-wrap justify-center gap-3 reveal">
      <button
        onclick="filterClients('all')"
        class="filter-btn active px-5 py-2.5 rounded-full text-sm font-semibold border-2 border-brand-500 bg-brand-500 text-white transition-all"
      >
        Semua
      </button>
      <button
        onclick="filterClients('Pendidikan')"
        class="filter-btn px-5 py-2.5 rounded-full text-sm font-semibold border-2 border-slate-300 text-slate-700 hover:border-brand-500 hover:text-brand-600 transition-all"
      >
        Pendidikan
      </button>
      <button
        onclick="filterClients('UMKM')"
        class="filter-btn px-5 py-2.5 rounded-full text-sm font-semibold border-2 border-slate-300 text-slate-700 hover:border-brand-500 hover:text-brand-600 transition-all"
      >
        UMKM
      </button>
    </div>

    <!-- Carousel Container -->
    <div class="mt-12 relative reveal">
      <!-- Carousel Wrapper -->
      <div class="relative overflow-hidden rounded-2xl" id="carouselWrapper">
        <!-- Carousel Track -->
        <div
          class="flex transition-transform duration-500 ease-out"
          id="carouselTrack"
          style="will-change: transform"
        >
          {% for client in clients %}
          <div
            class="client-slide flex-shrink-0 px-3"
            data-category="{{ client.category }}"
            style="width: calc(100% / 1); max-width: calc(100% / 1)"
          >
            {% set hasWebsite = client.website and client.website | trim |
            length > 0 %}

            {% if hasWebsite %}
  <a
    href="{{ client.website }}"
    target="_blank"
    rel="noopener noreferrer"
    class="card-hover group relative bg-white rounded-2xl p-6 border border-slate-200 hover:border-brand-300 transition-all duration-300 overflow-hidden block h-full"
  >
  {% else %}
  <div
    class="card-hover group relative bg-white rounded-2xl p-6 border border-slate-200 transition-all duration-300 overflow-hidden block h-full"
  >
  {% endif %}
              <div
                class="absolute inset-0 bg-gradient-to-br from-brand-50 to-cyan-50 opacity-0 group-hover:opacity-100 transition-opacity duration-300"
              ></div>

              <!-- Logo Container dengan Premium Placeholder -->
              <div class="relative flex items-center justify-center h-24 mb-4">
                {% if client.logo %}
                <img
                  src="{{ client.logo }}"
                  alt="Logo {{ client.name }}"
                  class="max-h-full max-w-full object-contain grayscale group-hover:grayscale-0 transition-all duration-300"
                  onerror="
                    this.style.display = 'none';
                    this.nextElementSibling.style.display = 'flex';
                  "
                />
                <!-- Premium placeholder (tersembunyi) -->
                <div
                  class="hidden relative w-20 h-20 rounded-2xl overflow-hidden flex items-center justify-center shadow-lg"
                >
                  <div
                    class="absolute inset-0 bg-gradient-to-br from-brand-500 via-brand-600 to-cyan-600"
                  ></div>
                  <div
                    class="absolute inset-0 opacity-20"
                    style="
                      background-image: radial-gradient(
                        circle at 20% 50%,
                        white 1px,
                        transparent 1px
                      );
                      background-size: 10px 10px;
                    "
                  ></div>
                  <span class="relative text-white font-bold text-2xl"
                    >{{ client.name | truncate(2, true, '') | upper }}</span
                  >
                </div>
                {% else %}
                <!-- Premium placeholder (langsung tampil) -->
                <div
                  class="relative w-20 h-20 rounded-2xl overflow-hidden flex items-center justify-center shadow-lg"
                >
                  <div
                    class="absolute inset-0 bg-gradient-to-br from-brand-500 via-brand-600 to-cyan-600"
                  ></div>
                  <div
                    class="absolute inset-0 opacity-20"
                    style="
                      background-image: radial-gradient(
                        circle at 20% 50%,
                        white 1px,
                        transparent 1px
                      );
                      background-size: 10px 10px;
                    "
                  ></div>
                  <span class="relative text-white font-bold text-2xl"
                    >{{ client.name | truncate(2, true, '') | upper }}</span
                  >
                </div>
                {% endif %}
              </div>

              <h3
                class="relative text-center font-bold text-ink text-sm mb-2 line-clamp-1 group-hover:text-brand-700 transition-colors"
              >
                {{ client.name }}
              </h3>

              <div class="relative flex justify-center mb-3">
                <span
                  class="text-xs px-2.5 py-1 rounded-full {% if client.category == 'Pendidikan' %}bg-amber-100 text-amber-700 {% elif client.category == 'UMKM' %}bg-emerald-100 text-emerald-700 {% elif client.category == 'Instansi' %}bg-brand-100 text-brand-700 {% elif client.category == 'Korporat' %}bg-fuchsia-100 text-fuchsia-700 {% else %}bg-slate-100 text-slate-700{% endif %}"
                >
                  {{ client.category }}
                </span>
              </div>

              <p
                class="relative text-center text-xs text-slate-600 line-clamp-2 leading-relaxed"
              >
                {{ client.description }}
              </p>

              <div
                class="absolute top-4 right-4 opacity-0 group-hover:opacity-100 transition-opacity duration-300"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="text-brand-600"
                >
                  <line x1="7" y1="17" x2="17" y2="7" />
                  <polyline points="7 7 17 7 17 17" />
                </svg>
              </div>
            {% if hasWebsite %}
  </a>
  {% else %}
  </div>
  {% endif %}
          </div>
          {% endfor %}
        </div>
      </div>

      <!-- Navigation Buttons -->
      <button
        id="prevBtn"
        class="absolute left-0 top-1/2 -translate-y-1/2 -translate-x-4 sm:-translate-x-6 w-12 h-12 rounded-full bg-white border-2 border-slate-200 hover:border-brand-500 hover:bg-brand-50 shadow-lg flex items-center justify-center transition-all duration-300 z-10 group"
        aria-label="Previous"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="text-slate-600 group-hover:text-brand-600 transition-colors"
        >
          <polyline points="15 18 9 12 15 6" />
        </svg>
      </button>

      <button
        id="nextBtn"
        class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-4 sm:translate-x-6 w-12 h-12 rounded-full bg-white border-2 border-slate-200 hover:border-brand-500 hover:bg-brand-50 shadow-lg flex items-center justify-center transition-all duration-300 z-10 group"
        aria-label="Next"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="text-slate-600 group-hover:text-brand-600 transition-colors"
        >
          <polyline points="9 18 15 12 9 6" />
        </svg>
      </button>

      <!-- Dots Indicator -->
      <div class="mt-8 flex justify-center gap-2" id="dotsContainer">
        <!-- Dots will be generated by JavaScript -->
      </div>
    </div>
  </div>
</section>

<style>
  /* Responsive slide widths */
  @media (min-width: 640px) {
    .client-slide {
      width: calc(100% / 2) !important;
      max-width: calc(100% / 2) !important;
    }
  }

  @media (min-width: 1024px) {
    .client-slide {
      width: calc(100% / 3) !important;
      max-width: calc(100% / 3) !important;
    }
  }

  @media (min-width: 1280px) {
    .client-slide {
      width: calc(100% / 4) !important;
      max-width: calc(100% / 4) !important;
    }
  }

  /* Smooth fade animation for filter */
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .client-slide {
    animation: fadeIn 0.5s ease-out;
  }
</style>

<script>
  // ============================================
  // CAROUSEL FUNCTIONALITY
  // ============================================
  class ClientsCarousel {
    constructor() {
      this.track = document.getElementById("carouselTrack");
      this.wrapper = document.getElementById("carouselWrapper");
      this.prevBtn = document.getElementById("prevBtn");
      this.nextBtn = document.getElementById("nextBtn");
      this.dotsContainer = document.getElementById("dotsContainer");

      this.currentIndex = 0;
      this.slidesPerView = this.getSlidesPerView();
      this.totalSlides = 0;
      this.autoplayInterval = null;
      this.autoplayDelay = 4000; // 4 seconds
      this.isPaused = false;

      this.init();
    }

    getSlidesPerView() {
      if (window.innerWidth >= 1280) return 4;
      if (window.innerWidth >= 1024) return 3;
      if (window.innerWidth >= 640) return 2;
      return 1;
    }

    init() {
      this.updateSlidesCount();
      this.createDots();
      this.updateCarousel();
      this.attachEventListeners();
      this.startAutoplay();
    }

    updateSlidesCount() {
      const visibleSlides = Array.from(this.track.children).filter(
        (slide) => slide.style.display !== "none",
      );
      this.totalSlides = Math.ceil(visibleSlides.length / this.slidesPerView);
      this.currentIndex = Math.min(this.currentIndex, this.totalSlides - 1);
    }

    createDots() {
      this.dotsContainer.innerHTML = "";
      for (let i = 0; i < this.totalSlides; i++) {
        const dot = document.createElement("button");
        dot.className = `w-2.5 h-2.5 rounded-full transition-all duration-300 ${
          i === this.currentIndex
            ? "bg-brand-600 w-8"
            : "bg-slate-300 hover:bg-slate-400"
        }`;
        dot.setAttribute("aria-label", `Go to slide ${i + 1}`);
        dot.addEventListener("click", () => this.goToSlide(i));
        this.dotsContainer.appendChild(dot);
      }
    }

    updateCarousel() {
      const slideWidth = 100 / this.slidesPerView;
      const translateX = -(this.currentIndex * slideWidth * this.slidesPerView);
      this.track.style.transform = `translateX(${translateX}%)`;

      // Update dots
      const dots = this.dotsContainer.children;
      Array.from(dots).forEach((dot, index) => {
        if (index === this.currentIndex) {
          dot.className =
            "w-8 h-2.5 rounded-full bg-brand-600 transition-all duration-300";
        } else {
          dot.className =
            "w-2.5 h-2.5 rounded-full bg-slate-300 hover:bg-slate-400 transition-all duration-300";
        }
      });

      // Update button states
      this.prevBtn.disabled = this.currentIndex === 0;
      this.nextBtn.disabled = this.currentIndex === this.totalSlides - 1;

      this.prevBtn.style.opacity = this.currentIndex === 0 ? "0.5" : "1";
      this.nextBtn.style.opacity =
        this.currentIndex === this.totalSlides - 1 ? "0.5" : "1";
    }

    goToSlide(index) {
      this.currentIndex = Math.max(0, Math.min(index, this.totalSlides - 1));
      this.updateCarousel();
      this.resetAutoplay();
    }

    nextSlide() {
      if (this.currentIndex < this.totalSlides - 1) {
        this.currentIndex++;
      } else {
        this.currentIndex = 0; // Loop back to start
      }
      this.updateCarousel();
    }

    prevSlide() {
      if (this.currentIndex > 0) {
        this.currentIndex--;
      } else {
        this.currentIndex = this.totalSlides - 1; // Loop to end
      }
      this.updateCarousel();
    }

    startAutoplay() {
      this.autoplayInterval = setInterval(() => {
        if (!this.isPaused) {
          this.nextSlide();
        }
      }, this.autoplayDelay);
    }

    stopAutoplay() {
      if (this.autoplayInterval) {
        clearInterval(this.autoplayInterval);
        this.autoplayInterval = null;
      }
    }

    resetAutoplay() {
      this.stopAutoplay();
      this.startAutoplay();
    }

    attachEventListeners() {
      // Navigation buttons
      this.prevBtn.addEventListener("click", () => {
        this.prevSlide();
        this.resetAutoplay();
      });

      this.nextBtn.addEventListener("click", () => {
        this.nextSlide();
        this.resetAutoplay();
      });

      // Pause on hover
      this.wrapper.addEventListener("mouseenter", () => {
        this.isPaused = true;
      });

      this.wrapper.addEventListener("mouseleave", () => {
        this.isPaused = false;
      });

      // Touch/Swipe support
      let touchStartX = 0;
      let touchEndX = 0;

      this.wrapper.addEventListener(
        "touchstart",
        (e) => {
          touchStartX = e.changedTouches[0].screenX;
        },
        { passive: true },
      );

      this.wrapper.addEventListener(
        "touchend",
        (e) => {
          touchEndX = e.changedTouches[0].screenX;
          this.handleSwipe();
        },
        { passive: true },
      );

      // Keyboard navigation
      document.addEventListener("keydown", (e) => {
        if (e.key === "ArrowLeft") {
          this.prevSlide();
          this.resetAutoplay();
        } else if (e.key === "ArrowRight") {
          this.nextSlide();
          this.resetAutoplay();
        }
      });

      // Responsive resize
      let resizeTimeout;
      window.addEventListener("resize", () => {
        clearTimeout(resizeTimeout);
        resizeTimeout = setTimeout(() => {
          const newSlidesPerView = this.getSlidesPerView();
          if (newSlidesPerView !== this.slidesPerView) {
            this.slidesPerView = newSlidesPerView;
            this.updateSlidesCount();
            this.createDots();
            this.updateCarousel();
          }
        }, 250);
      });
    }

    handleSwipe() {
      const swipeThreshold = 50;
      const diff = touchStartX - touchEndX;

      if (Math.abs(diff) > swipeThreshold) {
        if (diff > 0) {
          // Swipe left - next
          this.nextSlide();
        } else {
          // Swipe right - prev
          this.prevSlide();
        }
        this.resetAutoplay();
      }
    }

    // Filter functionality
    filterByCategory(category) {
      const slides = Array.from(this.track.children);

      slides.forEach((slide) => {
        if (category === "all" || slide.dataset.category === category) {
          slide.style.display = "";
        } else {
          slide.style.display = "none";
        }
      });

      // Reset carousel
      this.currentIndex = 0;
      this.updateSlidesCount();
      this.createDots();
      this.updateCarousel();
      this.resetAutoplay();
    }
  }

  // Initialize carousel
  const carousel = new ClientsCarousel();

  // Filter function (called from buttons)
  function filterClients(category) {
    const buttons = document.querySelectorAll(".filter-btn");

    // Update button styles
    buttons.forEach((btn) => {
      btn.classList.remove(
        "active",
        "bg-brand-500",
        "text-white",
        "border-brand-500",
      );
      btn.classList.add("border-slate-300", "text-slate-700");
    });

    event.target.classList.add(
      "active",
      "bg-brand-500",
      "text-white",
      "border-brand-500",
    );
    event.target.classList.remove("border-slate-300", "text-slate-700");

    // Filter carousel
    carousel.filterByCategory(category);
  }
</script>
