<!-- Tech Stack Compact -->
<div class="max-w-7xl mx-auto px-5 sm:px-8 reveal">
  <div class="bg-white/70 backdrop-blur rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-lg">
    <div class="flex items-center gap-2 mb-5">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-brand-600">
        <polyline points="16 18 22 12 16 6"/>
        <polyline points="8 6 2 12 8 18"/>
      </svg>
      <h3 class="text-sm font-bold text-ink uppercase tracking-wider">Dibangun dengan Teknologi Terbaik</h3>
    </div>
    
    <!-- Marquee / Scrolling Tech Stack -->
    <div class="relative overflow-hidden">
      <div class="flex gap-3 animate-marquee">
        {% for tech in techs %}
        <div class="flex-shrink-0 flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white border border-slate-200 hover:border-brand-300 hover:shadow-md transition-all duration-300">
          <img 
            src="https://cdn.simpleicons.org/{{ tech.icon }}" 
            alt="{{ tech.name }}"
            class="w-5 h-5"
            loading="lazy"
          />
          <span class="text-sm font-semibold text-ink whitespace-nowrap">{{ tech.name }}</span>
        </div>
        {% endfor %}
        <!-- Duplicate for seamless loop -->
        {% for tech in techs %}
        <div class="flex-shrink-0 flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white border border-slate-200 hover:border-brand-300 hover:shadow-md transition-all duration-300">
          <img 
            src="https://cdn.simpleicons.org/{{ tech.icon }}" 
            alt="{{ tech.name }}"
            class="w-5 h-5"
            loading="lazy"
          />
          <span class="text-sm font-semibold text-ink whitespace-nowrap">{{ tech.name }}</span>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

